.steps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
.step-num { color: var(--accent); font-weight: 800; font-size: 13px; }
.step-item h4 { font-size: 15px; margin: 2px 0 4px; }
.step-item p { font-size: 12px; color: var(--text-muted); }
.contact-banner {
background: linear-gradient(135deg, #4c141b, #23121d); border: 1px solid rgba(248,113,113,0.3);
border-radius: var(--radius); padding: 24px; margin-bottom: 36px;
display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;
}
/* FORMS & CABINET */
.panel-box {
max-width: 680px; margin: 0 auto 24px; background: var(--bg-card);
border: 1px solid var(--border); border-radius: var(--radius); padding: 24px;
}
.form-group { margin-bottom: 14px; }
.form-group label { display: block; font-size: 13px; color: var(--text-muted); margin-bottom: 6px; }
.form-control {
width: 100%; background: var(--bg-input); border: 1px solid var(--border);
color: #fff; padding: 11px 14px; border-radius: 10px; font-size: 14px;
}
.tabs { display: flex; background: var(--bg-input); padding: 4px; border-radius: 12px; margin-bottom: 20px; }
.tab-btn { flex: 1; padding: 10px; border-radius: 9px; background: transparent; color: var(--text-muted); font-weight: 700; }
.tab-btn.active { background: var(--accent); color: #0b0e17; }
/* LEGAL */
.legal-block h3 { color: var(--accent); margin: 18px 0 8px; font-size: 17px; }
.legal-block p, .legal-block li { font-size: 14px; color: #cbd5e1; margin-bottom: 8px; }
.legal-block ul { padding-left: 20px; }
/* MODAL */
.modal-backdrop {
position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 200;
display: none; align-items: center; justify-content: center; padding: 16px;
}
.modal-backdrop.open { display: flex; }
.modal-card {
background: var(--bg-card); border: 1px solid var(--border); border-radius: 18px;
max-width: 560px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 22px; position: relative;
}
.modal-close {
position: absolute; top: 14px; right: 14px; background: var(--bg-input); color: #fff;
width: 32px; height: 32px; border-radius: 50%; font-size: 16px;
}
.comment-item {
background: var(--bg-input); padding: 10px 12px; border-radius: 10px; margin-bottom: 8px; font-size: 13px;
}
/* FOOTER & MOBILE NAV */
footer { border-top: 1px solid var(--border); padding: 32px 16px; margin-top: 40px; color: var(--text-muted); font-size: 13px; }
.footer-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
.footer-links button { display: block; background: none; color: var(--text-muted); margin-bottom: 8px; font-size: 13px; text-align: left; }
.footer-links button:hover { color: var(--accent); }
.floating-wa {
position: fixed; right: 18px; bottom: 76px; z-index: 90; width: 52px; height: 52px;
border-radius: 50%; background: var(--accent); color: #0b0e17; font-size: 24px;
display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(248,113,113,0.4);
}
.bottom-nav {
position: fixed; bottom: 0; left: 0; right: 0; background: #0f1320; border-top: 1px solid var(--border);
display: flex; justify-content: space-around; padding: 8px 0; z-index: 95;
}
.bottom-nav button {
background: none; color: var(--text-muted); display: flex; flex-direction: column; align-items: center;
font-size: 11px; gap: 3px;
}
.bottom-nav button.active { color: var(--accent); }
.toast {
position: fixed; top: 72px; right: 16px; background: #1e293b; border: 1px solid var(--accent);
color: #fff; padding: 12px 18px; border-radius: 10px; z-index: 300; font-size: 13px;
display: none; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
}
@media (max-width: 768px) {
.nav-links { display: none; }
.cat-grid { grid-template-columns: repeat(2, 1fr); }
.steps-box { grid-template-columns: 1fr; }
}
